---
import { getPosts, groupCount, dateParts } from '../lib/posts';

const posts = await getPosts();

const categoryCounts = groupCount(posts, (post) => post.data.categories);

const yearCounts = new Map<string, number>();

for (const post of posts) {
  const year = String(dateParts(post.data.date).year);
  yearCounts.set(year, (yearCounts.get(year) ?? 0) + 1);
}

const categories = [...categoryCounts.entries()];
const years = [...yearCounts.entries()];

const friends = [
  { name: 'GitHub', url: 'https://github.com/' },
  { name: 'Astro', url: 'https://astro.build/' },
  { name: 'Sass', url: 'https://sass-lang.com/' },
  { name: 'PostCSS', url: 'https://postcss.org/' },
  { name: 'GitHub Pages', url: 'https://pages.github.com/' },
];

const slug = (value: string) =>
  value
    .toLowerCase()
    .replace(/\s+/g, '-')
    .replace(/[^\w\u4e00-\u9fff-]/g, '');
---

{/*
    The rail beside the articles. It is a map of the site, not a list of
    everything: the categories, the archive years and the friend links.

    Every group is a band of pills that wraps, so the rail stays short
    next to the article list. The tags do not live here — forty of them
    would be a screenful of rows — they are the tag cloud at the bottom of
    the home page.
*/}
<aside data-pagefind-ignore class="sidebar">
    <section>
        <div class="aside-header">
            <i class="icon icon-triangle"></i> <span>分类</span>
        </div>
        <ul class="chip-list">
        {categories.map(([category, count]) => (
            <li>
                <a href={`/article/categories.html#${slug(category)}`}>
                    <span>{category}</span>
                    <span class="chip-count">{count}</span>
                </a>
            </li>
        ))}
        </ul>
    </section>
    <section>
        <div class="aside-header">
            <i class="icon icon-calendar"></i> <span>时间归档</span>
        </div>
        <ul class="chip-list">
        {years.map(([year, count]) => (
            <li>
                <a href={`/article/archives.html#${year}`}>
                    <span>{year}</span>
                    <span class="chip-count">{count}</span>
                </a>
            </li>
        ))}
        </ul>
    </section>
    <section>
        <div class="aside-header">
            <i class="icon icon-circle"></i> <span>友情链接</span>
        </div>
        <ul class="chip-list">
        {friends.map((friend) => (
            <li>
                <a href={friend.url} target="_blank" rel="noopener noreferrer">
                    <span>{friend.name}</span>
                </a>
            </li>
        ))}
        </ul>
    </section>
</aside>
