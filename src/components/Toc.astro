---
interface Heading {
    depth: number;
    slug: string;
    text: string;
}

interface Props {
    headings: Heading[];
    label?: string;
    title?: string;
}

const { headings, label = '文章目录', title = '目录' } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{items.length > 0 && (
    <nav class="toc" aria-label={label} data-pagefind-ignore>
        <h2 class="toc-title">{title}</h2>
        <ul class="toc-list">
            {items.map((heading) => (
                <li class={`toc-item toc-level-${heading.depth}`}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
            ))}
        </ul>
    </nav>
)}
