---
interface Heading {
    depth: number;
    slug: string;
    text: string;
}

interface Props {
    headings: Heading[];
}

const { headings } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{items.length > 0 && (
    <nav class="toc" aria-label="文章目录" data-pagefind-ignore>
        <h2 class="toc-title">目录</h2>
        <ul class="toc-list">
            {items.map((heading) => (
                <li class={`toc-item toc-level-${heading.depth}`}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
            ))}
        </ul>
    </nav>
)}
