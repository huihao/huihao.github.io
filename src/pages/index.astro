---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import Pagination from '../components/Pagination.astro';
import { getPosts, getTranslations, findTranslation } from '../lib/posts';
import { SITE } from '../lib/site';

const posts = await getPosts();
const translations = await getTranslations();

const pageSize = SITE.perPage;
const total = Math.ceil(posts.length / pageSize);
const slice = posts.slice(0, pageSize);
---

<BaseLayout title={SITE.title} description={SITE.description} canonical="/">
    <div data-pagefind-ignore>
        <h1 class="visually-hidden">{SITE.title} · 最新文章</h1>
        <div class="lang-filter" data-lang-filter role="group" aria-label="按语言阅读文章列表">
            <button type="button" class="lang-filter-item is-active" data-lang-filter-item="zh">中文</button>
            <button type="button" class="lang-filter-item" data-lang-filter-item="en">English</button>
        </div>

        {slice[0] && (
            <Card
                post={slice[0]}
                translation={findTranslation(slice[0], [...translations, ...posts])}
                variant="featured"
            />
        )}

        {slice.length > 1 && (
            <div class="article-list">
                {slice.slice(1).map((post) => (
                    <Card post={post} translation={findTranslation(post, [...translations, ...posts])} />
                ))}
            </div>
        )}

        <Pagination current={1} total={total} />
    </div>
</BaseLayout>
