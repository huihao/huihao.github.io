{
  "name": "huihao.github.io",
  "version": "1.0.0",
  "description": "my blog",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm-run-all build:css build:img build:js build:assets",
    "build:css": "node scripts/build-css.mjs",
    "build:css:min": "node scripts/build-css.mjs --minify",
    "build:img": "node scripts/build-img.mjs",
    "build:js": "node scripts/build-js.mjs",
    "build:assets": "node scripts/build-assets.mjs",
    "build:search": "node scripts/build-search.mjs",
    "clean": "node scripts/clean.mjs",
    "lint:css": "stylelint \"src/sass/**/*.scss\"",
    "lint:css:fix": "stylelint \"src/sass/**/*.scss\" --fix",
    "watch:css": "node scripts/build-css.mjs --watch",
    "dev": "npm-run-all --parallel watch:css dev:serve",
    "dev:serve": "browser-sync start --server --files \"dist/**/*, *.html, _includes/**/*, _layouts/**/*\" --port 5050 --no-open --ignore \"node_modules/**\" --ignore \".git/**\"",
    "site": "bundle exec jekyll serve --watch"
  },
  "browserslist": [
    ">= 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead",
    "not op_mini all"
  ],
  "keywords": [
    "blog"
  ],
  "license": "ISC",
  "devDependencies": {
    "autoprefixer": "^10.6.2",
    "browser-sync": "^3.0.4",
    "cssnano": "^9.9.0",
    "npm-run-all": "^4.1.5",
    "pagefind": "^1.6.0",
    "postcss": "^8.5.32",
    "postcss-preset-env": "^10.4.0",
    "sass": "^1.89.2",
    "sharp": "^0.35.5",
    "stylelint": "^16.23.0",
    "stylelint-config-standard-scss": "^14.0.0"
  }
}
